# Copy to .env and fill in your own keys. Never commit the real .env (see .gitignore).

# Google Gemini API key — https://aistudio.google.com/apikey
NOVA_GEMINI_API_KEY=

# Groq API key (also used for Whisper STT) — https://console.groq.com/keys
NOVA_GROQ_API_KEY=

# OpenRouter API key (M8: many models behind one key, e.g. Nemotron) — https://openrouter.ai/keys
NOVA_OPENROUTER_API_KEY=

# Override the app's data directory (settings.json, memory/, conversations/, logs/).
# Defaults to %APPDATA%\NOVA. Mainly useful for tests or a portable install.
NOVA_DATA_DIR=

# DEBUG | INFO | WARNING | ERROR (default: INFO)
NOVA_LOG_LEVEL=

# Test-only: redirect the Desktop Organizer tool away from the real Desktop.
NOVA_DESKTOP_OVERRIDE=
